APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── Website Publik (config/site.php) ───────────────────────────
SITE_WHATSAPP=6285217423987
SITE_WHATSAPP_DISPLAY="+62 852-1742-3987"
SITE_EMAIL=halo@tarakanartclass.com
SITE_INSTAGRAM=tarakanartclass
SITE_ADDRESS="Jl. Yos Sudarso No. 12, Tarakan, Kalimantan Utara"
# Isi atribut src dari iframe "Sematkan peta" Google Maps. Kosongkan untuk memakai bawaan config.
SITE_MAPS_EMBED=
SITE_LEAD_EMAIL=
SITE_CREDIT_URL=

# ─── SEO (config/site.php → 'seo') ──────────────────────────────
# Kode verifikasi Google Search Console. Ambil dari Search Console →
# tambah properti "Awalan URL" → Verifikasi lewat "Tag HTML", lalu salin
# HANYA isi content="..."-nya ke sini. Kosong = tag tidak dicetak.
SITE_GOOGLE_VERIFICATION=

# Alamat studio dipecah per bagian untuk data terstruktur schema.org.
# Kosongkan untuk memakai nilai bawaan di config/site.php.
SITE_ADDRESS_STREET="Jl. Yos Sudarso No. 12"
SITE_ADDRESS_CITY=Tarakan
SITE_ADDRESS_REGION="Kalimantan Utara"
SITE_ADDRESS_POSTAL=
# Koordinat studio. Ambil di Google Maps: klik kanan lokasi → angka pertama
# lintang, kedua bujur.
SITE_GEO_LAT=3.3064980
SITE_GEO_LNG=117.5775501

# ─── Midtrans Snap (config/midtrans.php) ────────────────────────
# Ambil di Dashboard Midtrans → Settings → Access Keys. Sandbox & Production
# punya pasangan kunci berbeda. Selama SERVER_KEY kosong, pembayaran online
# mati dan sistem kembali ke konfirmasi lunas manual.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_EXPIRY_HOURS=24
# Channel yang boleh muncul di popup Snap: hanya Virtual Account. QRIS & dompet
# digital tidak didaftarkan (tidak bisa dicek ulang lewat order_id), begitu pula
# kartu kredit dan gerai ritel. Kosongkan untuk memakai semua channel yang aktif
# di Dashboard Midtrans.
MIDTRANS_ENABLED_PAYMENTS=bca_va,bni_va,bri_va,cimb_va,permata_va,other_va,echannel
